# ===============================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN BÁN HÀNG AI
# ===============================================

# Port máy chủ web
PORT=5000

# ---------------------------------------------------------
# CẤU HÌNH API KEY (QUAN TRỌNG)
# ---------------------------------------------------------
# DÁN API KEY GEMINI CỦA BẠN VÀO ĐÂY.
# Nếu bạn muốn đổi API Key mới, hãy sửa dòng dưới đây.
# (Bạn cũng có thể cấu hình thông qua giao diện Web của ứng dụng)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# ---------------------------------------------------------
# CẤU HÌNH MODEL
# ---------------------------------------------------------
# Model Gemini dùng cho UC09, UC10 và UC11
GEMINI_MODEL=gemini-2.5-flash

# Model dùng cho Embedding RAG (Level 3)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Cấu hình RAG
CHROMA_DB_PATH=ai/vector_db
RAG_TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=100

